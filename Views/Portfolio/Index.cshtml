    <div class="container py-4">
        <div class="text-center mb-5">
            <div class="section-badge text-primary fw-semibold small text-uppercase mb-2">Contact</div>
            <h2 class="display-6 fw-bold">Get In Touch</h2>
            <p class="text-muted">Have a project in mind? Let's talk.</p>
        </div>
        <div class="row justify-content-center g-4">
            <div class="col-md-4 text-center">
                <div class="contact-card p-4 bg-white rounded-3 shadow-sm h-100">
                    <i class="bi bi-envelope-fill text-primary fs-2 mb-3 d-block"></i>
                    <h6 class="fw-bold">Email</h6>
                    <a href="mailto:john@example.com" class="text-muted text-decoration-none">áimiliostsiaprazis@gmail.com</a>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="contact-card p-4 bg-white rounded-3 shadow-sm h-100">
                    <i class="bi bi-linkedin text-primary fs-2 mb-3 d-block"></i>
                    <h6 class="fw-bold">LinkedIn</h6>
                    <a href="#" class="text-muted text-decoration-none">linkedin.com/in/aimiliostsiaprazis</a>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="contact-card p-4 bg-white rounded-3 shadow-sm h-100">
                    <i class="bi bi-github text-primary fs-2 mb-3 d-block"></i>
                    <h6 class="fw-bold">GitHub</h6>
                    <a href="#" class="text-muted text-decoration-none">github.com/AimiliosTsiaprazis</a>
                </div>
            </div>
        </div>
